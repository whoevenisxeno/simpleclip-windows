[Unit]
Description=SimpleClip instant-replay daemon
Documentation=https://github.com/whoevenisxeno/SimpleClip
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/scd --foreground
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
